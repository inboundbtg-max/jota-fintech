# 🔐 VARIÁVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para .env e preencha com seus valores
# NUNCA commit .env em git (já está em .gitignore)

# 📌 API CLAUDE
# Obter em: https://console.anthropic.com/account/keys
# Custo: R$ 3/1M input tokens + R$ 15/1M output tokens (Sonnet)
# Exemplo: sk-ant-v0-abc123def456...
CLAUDE_API_KEY=seu_api_key_aqui

# 📌 (Opcional) API OPENAI (para experimentos futuros)
# Obter em: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=seu_api_key_aqui

# 📌 (Opcional) API META/FACEBOOK
# Para conexão com Meta Ads (Dia 4-5)
META_ACCESS_TOKEN=seu_token_aqui

# 📌 (Opcional) API GOOGLE
# Para conexão com Google Ads (Dia 4-5)
GOOGLE_API_KEY=seu_api_key_aqui
